{
  "name": "n8n-nodes-whatsplaid",
  "version": "0.2.0",
  "description": "Use the Whatsplaid API in n8n workflows.",
  "license": "MIT",
  "homepage": "https://whatsplaid.com",
  "bugs": {
    "url": "https://github.com/iN2Git/n8n-nodes-whatsplaid/issues"
  },
  "keywords": ["n8n-community-node-package", "whatsplaid", "whatsapp", "automation", "crm"],
  "author": {
    "name": "iN2",
    "email": "36140509+iN2Git@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iN2Git/n8n-nodes-whatsplaid.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "npm run build && node --test tests/*.test.cjs",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": ["dist/credentials/WhatsplaidApi.credentials.js"],
    "nodes": ["dist/nodes/Whatsplaid/Whatsplaid.node.js"]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": { "n8n-workflow": "*" }
}
